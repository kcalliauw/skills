#!/usr/bin/env python3
"""Lint every skill: frontmatter, naming, plugin manifest coverage, executable scripts."""

import json
import os
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
NAME = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def frontmatter(path: Path) -> dict:
    text = path.read_text()
    if not text.startswith("---\n"):
        return {}
    block = text[4 : text.find("\n---", 4)]
    fields, parent = {}, None
    for line in block.splitlines():
        if not line.strip():
            continue
        key, _, value = line.strip().partition(":")
        if line.startswith((" ", "\t")) and parent:
            fields[f"{parent}.{key}"] = value.strip()
        else:
            parent = key if not value.strip() else None
            fields[key] = value.strip()
    return fields


def main() -> int:
    errors = []
    skills = sorted(p.parent for p in (ROOT / "skills").glob("*/*/SKILL.md"))
    manifest = json.loads((ROOT / ".claude-plugin" / "plugin.json").read_text())
    listed = {(ROOT / p).resolve() for p in manifest.get("skills", [])}
    for skill in skills:
        rel = skill.relative_to(ROOT)
        meta = frontmatter(skill / "SKILL.md")
        if meta.get("name") != skill.name:
            errors.append(f"{rel}: frontmatter name {meta.get('name')!r} must equal the folder name")
        if not NAME.match(skill.name):
            errors.append(f"{rel}: name must be lowercase words joined by hyphens")
        if len(meta.get("description", "")) < 20:
            errors.append(f"{rel}: description is missing or too short")
        if skill.resolve() not in listed:
            errors.append(f"{rel}: not listed in .claude-plugin/plugin.json")
        for script in (skill / "scripts").glob("*") if (skill / "scripts").is_dir() else []:
            if script.is_file() and not os.access(script, os.X_OK):
                errors.append(f"{script.relative_to(ROOT)}: not executable")
    for path in listed - {s.resolve() for s in skills}:
        errors.append(f"plugin.json lists {path} but it has no SKILL.md")
    for error in errors:
        print(error, file=sys.stderr)
    print(f"{len(skills)} skills checked, {len(errors)} problem(s)")
    return 1 if errors else 0


if __name__ == "__main__":
    sys.exit(main())
