#!/usr/bin/env python3
"""Fake `codex exec`: writes a fixture review to the -o target.

The code-review pass uses FAKE_CODEX_REVIEW; the security pass (its system
prompt is the generated security prompt) uses FAKE_CODEX_SECURITY_REVIEW, or a
clean review when that is unset.
"""
import json, os, sys, shutil
args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("codex " + " ".join(args) + "\n")
if os.environ.get("FAKE_CODEX_FAIL"):
    sys.stderr.write(os.environ["FAKE_CODEX_FAIL"] + "\n")
    sys.exit(1)
if sys.stdin.isatty():
    sys.exit("stdin must not be a terminal")
out = args[args.index("-o") + 1]
security = any("security-system-prompt" in a for a in args)
fixture = os.environ.get("FAKE_CODEX_SECURITY_REVIEW" if security else "FAKE_CODEX_REVIEW")
if fixture:
    shutil.copy(fixture, out)
else:
    json.dump({"findings": [], "overall_correctness": "patch is correct",
               "overall_explanation": "clean", "overall_confidence_score": 0.9}, open(out, "w"))
