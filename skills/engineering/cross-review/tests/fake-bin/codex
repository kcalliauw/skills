#!/usr/bin/env python3
"""Fake `codex exec`: writes FAKE_CODEX_REVIEW (a JSON file path) to the -o target."""
import os, sys, shutil
args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("codex " + " ".join(args) + "\n")
if os.environ.get("FAKE_CODEX_FAIL"):
    sys.stderr.write(os.environ["FAKE_CODEX_FAIL"] + "\n")
    sys.exit(1)
if sys.stdin.isatty():
    sys.exit("stdin must not be a terminal")
out = args[args.index("-o") + 1]
shutil.copy(os.environ["FAKE_CODEX_REVIEW"], out)
