#!/usr/bin/env python3
"""Fake `claude -p`: prints an envelope whose structured_output is a fixture review.

The code-review pass uses FAKE_CLAUDE_REVIEW; the security pass uses
FAKE_CLAUDE_SECURITY_REVIEW, or a clean review when that is unset.
"""
import json, os, sys
args = sys.argv[1:]
with open(os.environ["FAKE_LOG"], "a") as log:
    log.write("claude " + " ".join(a.replace("\n", " ")[:80] for a in args) + "\n")
security = any("security-system-prompt" in a for a in args)
fixture = os.environ.get("FAKE_CLAUDE_SECURITY_REVIEW" if security else "FAKE_CLAUDE_REVIEW")
review = json.load(open(fixture)) if fixture else {
    "findings": [], "overall_correctness": "patch is correct",
    "overall_explanation": "clean", "overall_confidence_score": 0.9}
print(json.dumps({"type": "result", "is_error": False, "result": json.dumps(review),
                  "structured_output": review, "total_cost_usd": 0.01, "num_turns": 2}))
